use std::cli;
use console;
use ibis;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Reconcile an invoice with split payments in integer minor units.");
        println!("Usage: ibis units prices payments");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = ibis_reconcile([2, 1], [125, 50], [200, 125]);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let units = console_vector(args_at(argv, 0));
        let prices = console_vector(args_at(argv, 1));
        let payments = console_vector(args_at(argv, 2));
        result = ibis_reconcile(units, prices, payments);
    }
    if len(result) == 0 { stderr_line("Invalid input for Ibis. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
