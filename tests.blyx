use std::cli;
use ibis;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(ibis_reconcile([2, 1], [125, 50], [200, 125]), [300, 300, 0, 25]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(ibis_reconcile([2], [10], [4]), [20, 4, 16, 0]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(ibis_reconcile([], [], []), [0, 0, 0, 0]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(ibis_reconcile([1], [], []), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(ibis_reconcile([infinity], [125, 50], [200, 125]), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(ibis_reconcile([2, 1], [infinity], [200, 125]), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(ibis_reconcile([2, 1], [125, 50], [infinity]), []) { stderr_line("case 7 failed"); process_exit(1); }
    println!("passed");
}
